#: ../../source/use-cases/scientists.rst:42 582078eee6e84c0da02cbd5fbeaf6dea
msgid "Author preprint listing — paper titles, IDs, dates"
msgstr ""
"Liste des préimpressions de l'auteur : titres, identifiants et dates des "
